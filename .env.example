# ===== Claude API =====
ANTHROPIC_AUTH_TOKEN=your_auth_token
ANTHROPIC_BASE_URL=https://your-proxy/anthropic
ANTHROPIC_MODEL=mimo-v2.5-pro

# ===== CLI 透传 =====
CLI_ACCESS_PASSWORD=your_password

# ===== 文件传输 =====
# 生成文件下发的工作区根目录（默认当前项目目录）
IM_WORKSPACE_ROOT=
# 允许自动下发的文件类型
IM_DELIVER_EXTENSIONS=.docx,.xlsx,.pptx,.pdf,.csv,.txt,.md,.zip,.png,.jpg,.jpeg,.gif
# 单文件大小限制（默认 20MB，兼容企业微信）
IM_DELIVER_MAX_BYTES=20971520
# 单次消息最多下发文件数
IM_DELIVER_MAX_FILES=5

# ===== 企业微信 =====
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENTID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ===== 个人微信（iLink Bot 官方 API，安全不封号） =====
WEIXIN_TOKEN=
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
WEIXIN_ALLOW_FROM=

# ===== 飞书 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 钉钉 =====
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=

# ===== Slack =====
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# ===== Discord =====
DISCORD_BOT_TOKEN=

# ===== LINE =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ===== WhatsApp (Meta Business) =====
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ===== Signal (signal-cli-rest-api) =====
SIGNAL_API_URL=http://localhost:8080
SIGNAL_NUMBER=

# ===== Matrix =====
MATRIX_HOMESERVER=https://matrix.org
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=

# ===== Microsoft Teams =====
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# ===== Google Chat =====
GOOGLECHAT_CREDENTIALS=
GOOGLECHAT_PROJECT_ID=

# ===== 服务端口 =====
PORT=80
