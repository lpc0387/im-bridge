# Claude API
ANTHROPIC_API_KEY=sk-ant-xxx
# 或使用代理
ANTHROPIC_AUTH_TOKEN=your_token
ANTHROPIC_BASE_URL=https://your-proxy/anthropic
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 企微应用（双向对话）
WECOM_CORPID=ww4a417a7419e691c5
WECOM_CORPSECRET=your_secret
WECOM_AGENTID=1000002
WECOM_TOKEN=your_token
WECOM_ENCODING_AES_KEY=your_aes_key

# 企微 Webhook（单向推送，可选）
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 飞书（可选，WebSocket 长连接，无需公网 IP）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 钉钉（可选，Stream 模式，无需公网 IP）
DINGTALK_APP_KEY=xxx
DINGTALK_APP_SECRET=xxx
DINGTALK_ROBOT_CODE=xxx

# Telegram（可选，Long Polling，无需公网 IP）
TELEGRAM_BOT_TOKEN=xxx

# CLI 透传
CLI_ACCESS_PASSWORD=Loong
CLI_TIMEOUT_MS=300000

# Web 管理界面
WEB_PORT=8081
WEB_AUTH_USERNAME=admin
WEB_AUTH_PASSWORD=your_password

# 服务端口
PORT=3000
